# Checklist only — do not put real secrets in git.
# Prefer Multilist → Connect eBay → paste BYO keys (browser localStorage).
# Or set the same names as Cloudflare secrets/vars (see docs/EBAY_OAUTH.md).

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_ENV=sandbox
EBAY_REDIRECT_URI=https://fashionistas.ai/api/ebay/oauth/callback
