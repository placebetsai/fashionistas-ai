{
  "manifest_version": 3,
  "name": "Fashionistas Crosslister",
  "version": "1.0.0",
  "description": "One button posts a closet item to every marketplace automatically: fully submitted, live listing URL captured, no manual steps.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "https://www.poshmark.com/*",
    "https://poshmark.com/*",
    "https://www.mercari.com/*",
    "https://jp.mercari.com/*",
    "https://www.depop.com/*",
    "https://depop.com/*",
    "https://www.vinted.com/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.fr/*",
    "https://www.vinted.it/*",
    "https://www.vinted.es/*",
    "https://www.grailed.com/*",
    "https://grailed.com/*",
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.kidizen.com/*",
    "https://www.vestiairecollective.com/*",
    "https://vestiairecollective.com/*",
    "https://whatnot.com/*",
    "https://www.whatnot.com/*",
    "https://www.ebay.com/*",
    "https://www.etsy.com/*",
    "https://fashionistas.ai/*",
    "https://www.fashionistas.ai/*",
    "https://fashionistas-api.fashionistas1979.workers.dev/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://fashionistas.ai/*",
      "https://www.fashionistas.ai/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.poshmark.com/*",
        "https://poshmark.com/*",
        "https://www.mercari.com/*",
        "https://jp.mercari.com/*",
        "https://www.depop.com/*",
        "https://www.vinted.com/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.it/*",
        "https://www.vinted.es/*",
        "https://www.grailed.com/*",
        "https://www.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.kidizen.com/*",
        "https://www.vestiairecollective.com/*",
        "https://whatnot.com/*",
        "https://www.whatnot.com/*",
        "https://www.ebay.com/*",
        "https://www.etsy.com/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.poshmark.com/*",
        "https://poshmark.com/*",
        "https://www.mercari.com/*",
        "https://jp.mercari.com/*",
        "https://www.depop.com/*",
        "https://www.vinted.com/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.it/*",
        "https://www.vinted.es/*",
        "https://www.grailed.com/*",
        "https://www.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.kidizen.com/*",
        "https://www.vestiairecollective.com/*",
        "https://whatnot.com/*",
        "https://www.whatnot.com/*",
        "https://www.ebay.com/*",
        "https://www.etsy.com/*"
      ],
      "js": [
        "content/formkit.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://fashionistas.ai/*",
        "https://www.fashionistas.ai/*"
      ],
      "js": [
        "content/announce.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
